# Copy to `.env` for local overrides. Bun loads `.env` automatically.
# `apps/server/src/config.ts` still has the same defaults if a key is missing.

PORT=3000
SERVER_NAME=dict poc
# Unset: every data/<pair>.sqlite. Set to limit, e.g. LANGUAGES=de_en,pl_en
# LANGUAGES=
# Send the `legal` section: links to the privacy policy and terms, and the
# sha256 of each one's source text. Without it, clients tell users to use the
# server only for testing.
INCLUDE_LEGAL=true
# Accept the sentence around a word (`context` feature). The privacy policy must say so.
CONTEXT=true
VERIFICATION_URLS=https://example.invalid/verify
# Where the documents are published.
PRIVACY_LINK=https://example.invalid/privacy
TOS_LINK=https://example.invalid/tos
# Their source text, exactly as published at the links: the hash is taken over
# these files, and any change to them makes clients ask users to review it.
# Copy legal/privacy.example.md and legal/terms.example.md here and fill in
# their placeholders (legal/README.md). data/ is not in git.
PRIVACY_FILE=data/privacy.md
TOS_FILE=data/terms.md
IDENTITY_FILE=data/identity.json
# Optional summaries of the last change, shown with the notice; at most 500 characters.
# PRIVACY_CHANGE=We now keep logs for 7 days instead of 14.
# TOS_CHANGE=
