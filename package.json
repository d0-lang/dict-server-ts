{
  "name": "dict-server",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/server/src/index.ts",
    "start": "bun apps/server/src/index.ts",
    "test": "bun --bun run vitest run",
    "typecheck": "tsc --noEmit -p .",
    "import": "bun apps/importer/src/cli.ts",
    "filter": "bun apps/importer/src/filterCli.ts",
    "bench:context": "bun apps/server/eval/context-bench.ts",
    "bench:segments": "bun apps/server/eval/segments-bench.ts",
    "format": "prettier --write .",
    "spec": "bun packages/core/scripts/spec.ts"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/bun": "latest",
    "prettier": "^3.9.10",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
